[application]
config/name="Startup Tycoon"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.015, 0.035, 0.08, 1)

[autoload]
GameState="*res://scripts/game_state.gd"
AnalyticsService="*res://scripts/analytics_service.gd"
MonetizationService="*res://scripts/monetization_service.gd"
VisualProfileService="*res://scripts/visual_profile_service.gd"
